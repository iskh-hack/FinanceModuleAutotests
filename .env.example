# Защита от случайного запуска тестов с финансовыми side effects.
FM_ALLOW_SIDE_EFFECTS=false
FM_CONFIRM_DOWNSTREAM_ISOLATED=false

# Kubernetes и Main Backend. Тест вызывает штатный producer через реальный заказ.
FM_KUBECTL_PATH=C:\QA\QAKnowledgeAgent\tools\kubectl\kubectl.exe
FM_KUBECONFIG=C:\Users\User\.kube\market-dev.yaml
FM_KUBE_INSECURE_SKIP_TLS_VERIFY=true
FM_KUBE_NAMESPACE=market
FM_MAIN_BACKEND_RESOURCE=auto
FM_MAIN_BACKEND_CONTAINER=service-market-core-backend-api

# PostgreSQL Finance Module. Используется только чтение.
FM_POSTGRES_DSN=postgresql://readonly_user:password@host:5432/database

# Магазин должен быть тестовым, finance-enabled и изолированным от реальных
# Blnk/MBonus операций. Клиент должен быть активным customer.
FM_TEST_SHOP_ID=
FM_TEST_CLIENT_PHONE=

# Ожидание асинхронной обработки.
FM_WAIT_TIMEOUT_SECONDS=120
FM_WAIT_INTERVAL_SECONDS=2
