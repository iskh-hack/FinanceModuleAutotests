# Защита от случайного запуска тестов с финансовыми side effects.
FM_ALLOW_SIDE_EFFECTS=false

# Kafka тестового окружения.
FM_KAFKA_BROKERS=
FM_KAFKA_ORDER_PAID_TOPIC=payments.order.paid
FM_KAFKA_SECURITY_PROTOCOL=SASL_SSL
FM_KAFKA_SASL_MECHANISM=PLAIN
FM_KAFKA_USERNAME=
FM_KAFKA_PASSWORD=

# PostgreSQL Finance Module. Используется только чтение.
FM_POSTGRES_DSN=postgresql://readonly_user:password@host:5432/database

# Постоянные тестовые сущности, заранее заведённые в Finance Module.
FM_TEST_MERCHANT_ID=
FM_TEST_SHOP_ID=
FM_TEST_PRODUCT_ID=
FM_TEST_CATEGORY_ID=

# Ожидание асинхронной обработки.
FM_WAIT_TIMEOUT_SECONDS=60
FM_WAIT_INTERVAL_SECONDS=2

