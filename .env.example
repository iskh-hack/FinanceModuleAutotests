FM_ALLOW_SIDE_EFFECTS=false
FM_CONFIRM_DOWNSTREAM_ISOLATED=false

# Read-only Finance Module database access.
FM_POSTGRES_DSN=postgresql://readonly_user:password@host:5432/database

# Publish through the deployed Core Backend KafkaEventProducer.
FM_KUBECTL_PATH=C:\QA\QAKnowledgeAgent\tools\kubectl.exe
FM_KUBECONFIG=C:\Users\User\.kube\market-dev.yaml
FM_KUBE_NAMESPACE=market
FM_MAIN_BACKEND_RESOURCE=pod/service-market-core-backend-api-xxxxxxxxxx-xxxxx
FM_MAIN_BACKEND_CONTAINER=service-market-core-backend-api
FM_SCENARIO_TIMEOUT_SECONDS=180
# Optional stable marker for reproducing a specific run. Normally leave empty.
FM_TEST_RUN_ID=

# Confirmed dev Market profile for the Finance Module happy path.
FM_TEST_MERCHANT_ID=741d63b1-f37e-48c3-b2bb-523ef03faf32
FM_TEST_SHOP_ID=273
FM_TEST_PRODUCT_ID=953940141
FM_TEST_CATEGORY_ID=4673
FM_TEST_CATEGORY_EXTERNAL_ID=b9f80162-6496-48df-b854-ed358a30bc0e
FM_TEST_CLIENT_PHONE=996500122279

# Real Market client checkout (used for MBANK order creation instead of kubectl).
FM_MARKET_BASE_URL=https://dev.m-market.kg
# Dev-only bypass login (settings.DEVELOPMENT_TOKEN on Core Backend): POST /api/users/mbankAuth/
# with {"token": "<value>+<phone>"} logs in as FM_TEST_CLIENT_PHONE without a password.
FM_MARKET_DEV_LOGIN_TOKEN=
FM_MBANK_WEBHOOK_TOKEN=

FM_WAIT_TIMEOUT_SECONDS=240
FM_WAIT_INTERVAL_SECONDS=2
